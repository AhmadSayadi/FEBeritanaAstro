---
/**
 * Web Stories list — Astro equivalent of Next's src/app/stories/page.tsx.
 */
import Layout from '@/layouts/Layout.astro'
import { apiFetchSafe, getImageUrl } from '@/lib/api'
import { Breadcrumb } from '@/components/layout/Breadcrumb'
import { SITE_URL_RAW } from '@/lib/env'
import type { SeoProps } from '@/lib/seo'

interface StoryItem {
  id: number
  title: string
  slug: string
  thumbnail_url: string
  category?: { name: string; slug: string }
  published_at: string
}

const seo: SeoProps = {
  title: 'Web Stories',
  ogTitle: 'Web Stories - Beritana',
  description: 'Kumpulan Web Stories visual dari Beritana. Berita dalam format cerita singkat yang menarik.',
  ogDescription: 'Kumpulan Web Stories visual dari Beritana.',
  canonical: '/stories',
}

let stories: StoryItem[] = []
try {
  const res = await apiFetchSafe<{ data: StoryItem[] }>('/stories', 60)
  stories = res?.data || []
} catch {
  // empty
}
---
<Layout seo={seo}>
  <Breadcrumb items={[{ name: 'Web Stories' }]} />
  <section class="container-main pb-12">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">Web Stories</h1>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Berita dalam format cerita visual yang singkat dan menarik</p>
    </div>

    {stories.length > 0 ? (
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        {stories.map((story) => (
          <a href={`/stories/${story.slug}`} class="group">
            <div class="relative aspect-[9/16] overflow-hidden rounded-xl">
              <img src={getImageUrl(story.thumbnail_url, { width: 400 })} alt={story.title} title={story.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
              <div class="absolute inset-x-3 bottom-3">
                <p class="line-clamp-3 text-sm font-semibold leading-tight text-white">{story.title}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-500">Belum ada Web Stories.</p>
    )}
  </section>
</Layout>
