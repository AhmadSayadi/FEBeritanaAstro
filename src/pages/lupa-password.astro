---
/**
 * Forgot password — Astro equivalent of Next's src/app/lupa-password/page.tsx. noindex.
 */
import Layout from '@/layouts/Layout.astro'
import { Breadcrumb } from '@/components/layout/Breadcrumb'
import { ForgotPasswordForm } from '@/components/pageviews/ForgotPasswordForm'
import type { SeoProps } from '@/lib/seo'

const seo: SeoProps = { title: 'Lupa Password', noindex: true, nofollow: true }
---
<Layout seo={seo}>
  <Breadcrumb items={[{ name: 'Lupa Password' }]} />
  <section class="container-main flex min-h-[60vh] items-center justify-center py-12">
    <div class="w-full max-w-md">
      <h1 class="mb-2 text-center text-2xl font-bold text-gray-900 dark:text-white">Lupa Password</h1>
      <p class="mb-6 text-center text-sm text-gray-500 dark:text-gray-400">
        Masukkan email Anda dan kami akan mengirimkan link untuk reset password.
      </p>
      <ForgotPasswordForm client:load />
    </div>
  </section>
</Layout>
