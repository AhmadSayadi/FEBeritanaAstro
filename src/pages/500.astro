---
/**
 * 500 — Astro equivalent of Next's src/app/error.tsx.
 * Same copy/classes. The "Coba Lagi" button reloads the page (an MPA has no
 * client-side error boundary `reset()`); kept as a tiny inline script so the
 * page itself ships no framework JS.
 */
import Layout from '@/layouts/Layout.astro'
import type { SeoProps } from '@/lib/seo'

const seo: SeoProps = {
  title: 'Terjadi Kesalahan',
  noindex: true,
  nofollow: true,
  noCanonical: true,
}
---
<Layout seo={seo}>
  <div class="container-main flex min-h-[60vh] flex-col items-center justify-center py-12 text-center">
    <h1 class="text-7xl font-bold text-gray-300">500</h1>
    <h2 class="mt-4 text-2xl font-bold text-gray-900">Terjadi Kesalahan</h2>
    <p class="mt-2 max-w-md text-gray-600">
      Maaf, terjadi kesalahan pada server. Silakan coba lagi.
    </p>
    <button id="retry-btn" class="btn-primary mt-6">Coba Lagi</button>
  </div>

  <script is:inline>
    document.getElementById('retry-btn')?.addEventListener('click', function () {
      window.location.reload()
    })
  </script>
</Layout>
