---
/**
 * Video Story list — Astro equivalent of Next's src/app/video/page.tsx.
 */
import Layout from '@/layouts/Layout.astro'
import { apiFetchCached, getImageUrl } from '@/lib/api'
import { Breadcrumb } from '@/components/layout/Breadcrumb'
import { SITE_URL_RAW } from '@/lib/env'
import type { SeoProps } from '@/lib/seo'

interface Video {
  id: number
  title: string
  slug: string
  thumbnail_url: string
  video_url: string
  duration: string
  source: string
  category: { name: string; slug: string; color?: string } | null
  published_at: string
}

const seo: SeoProps = {
  title: 'Video Story',
  ogTitle: 'Video Story - Beritana',
  description:
    'Kumpulan video berita terbaru dari beritana. Informasi menarik dan lengkap dalam format video vertikal.',
  canonical: '/video',
  image: {
    url: '/video/opengraph-image.png',
    width: 1200,
    height: 630,
    alt: 'Video Story Beritana',
  },
}

let videos: Video[] = []
try {
  const res = await apiFetchCached<{ data: Video[] }>('/videos', 60)
  videos = res.data
} catch {
  // empty
}
---
<Layout seo={seo}>
  <Breadcrumb items={[{ name: 'Video Story' }]} />
  <section class="container-main pb-12">
    <div class="mb-8 text-center">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">Video Story</h1>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Informasi menarik dan lengkap dalam format video</p>
    </div>

    {videos.length > 0 ? (
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {videos.map((video) => (
          <a href={`/video/${video.slug}`} class="group">
            <div class="relative aspect-[9/16] overflow-hidden rounded-xl">
              <img
                src={getImageUrl(video.thumbnail_url)}
                alt={video.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/20"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover:opacity-100">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90">
                  <svg class="h-6 w-6 text-gray-900" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </div>
              </div>
              {video.duration && (
                <span class="absolute bottom-2 right-2 rounded bg-black/70 px-1.5 py-0.5 text-[11px] font-medium text-white">{video.duration}</span>
              )}
              <div class="absolute inset-x-2 bottom-8">
                <p class="line-clamp-3 text-xs font-medium leading-tight text-white">{video.title}</p>
              </div>
            </div>
            <div class="mt-2">
              <h3 class="line-clamp-2 text-xs font-bold text-gray-900 group-hover:text-primary dark:text-white sm:text-sm">{video.title}</h3>
              <div class="mt-1 flex items-center gap-1 text-[11px] text-gray-500"><span>{video.source}</span></div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-500">Belum ada video.</p>
    )}
  </section>
</Layout>
