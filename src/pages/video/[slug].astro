---
/**
 * Video detail — Astro equivalent of Next's src/app/video/[slug]/page.tsx.
 * Emits VideoObject JSON-LD; ShareButtons hydrates as an island.
 */
import Layout from '@/layouts/Layout.astro'
import JsonLd from '@/components/astro/JsonLd.astro'
import { apiFetchCached, getImageUrl } from '@/lib/api'
import { formatDateID } from '@/lib/date'
import { Breadcrumb } from '@/components/layout/Breadcrumb'
import { ShareButtons } from '@/components/article/ShareButtons'
import { SITE_URL_RAW, SITE_NAME } from '@/lib/env'
import type { SeoProps } from '@/lib/seo'

interface Video {
  id: number
  title: string
  slug: string
  thumbnail_url: string
  thumbnail_alt?: string
  thumbnail_credit?: string
  video_url: string
  duration: string
  source: string
  category: { name: string; slug: string; color?: string } | null
  published_at: string
}

const { slug } = Astro.params
const siteUrl = (SITE_URL_RAW || 'https://beritana.com').replace(/\/$/, '')

async function getVideo(s: string): Promise<Video | null> {
  try {
    const res = await apiFetchCached<{ data: Video }>(`/videos/${s}`, 300)
    return res.data
  } catch {
    try {
      const res = await apiFetchCached<{ data: Video[] }>('/videos', 300)
      return res.data.find((v) => v.slug === s) || null
    } catch {
      return null
    }
  }
}

async function getRelatedVideos(currentSlug: string): Promise<Video[]> {
  try {
    const res = await apiFetchCached<{ data: Video[] }>('/videos', 300)
    return res.data.filter((v) => v.slug !== currentSlug).slice(0, 6)
  } catch {
    return []
  }
}

function getYouTubeEmbedUrl(url: string): string | null {
  if (!url) return null
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/)
  return match ? `https://www.youtube.com/embed/${match[1]}` : null
}

/**
 * Convert a human duration to a valid ISO-8601 duration for VideoObject.
 * Handles "HH:MM:SS", "MM:SS", "M:SS", and plain seconds ("90"). Returns
 * undefined if it can't parse — an absent `duration` is better than an invalid
 * one, which makes Google reject the whole VideoObject.
 */
function toIsoDuration(raw: string | undefined | null): string | undefined {
  if (!raw) return undefined
  const s = String(raw).trim()
  if (/^\d+$/.test(s)) {
    // plain seconds
    const total = parseInt(s, 10)
    const h = Math.floor(total / 3600)
    const m = Math.floor((total % 3600) / 60)
    const sec = total % 60
    return `PT${h ? h + 'H' : ''}${m ? m + 'M' : ''}${sec ? sec + 'S' : h || m ? '' : '0S'}`
  }
  const parts = s.split(':').map((p) => parseInt(p, 10))
  if (parts.some((n) => Number.isNaN(n))) return undefined
  let h = 0, m = 0, sec = 0
  if (parts.length === 3) [h, m, sec] = parts
  else if (parts.length === 2) [m, sec] = parts
  else return undefined
  return `PT${h ? h + 'H' : ''}${m ? m + 'M' : ''}${sec ? sec + 'S' : h || m ? '' : '0S'}`
}

const [video, relatedVideos] = await Promise.all([getVideo(slug!), getRelatedVideos(slug!)])

if (!video) {
  return Astro.rewrite('/404')
}

const embedUrl = getYouTubeEmbedUrl(video.video_url)

// Backend video records often have no own thumbnail — derive the YouTube poster
// from the video URL so OG image, VideoObject.thumbnailUrl, and the on-page
// images are never empty (empty thumbnailUrl makes Google drop the VideoObject).
function ytPoster(url: string): string | null {
  const m = url?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/)
  return m ? `https://i.ytimg.com/vi/${m[1]}/hqdefault.jpg` : null
}
const videoThumb =
  (video.thumbnail_url ? getImageUrl(video.thumbnail_url, { width: 1200 }) : null) ||
  ytPoster(video.video_url) ||
  '/images/fallback-thumb.svg'

const ogImage = videoThumb
const seo: SeoProps = {
  title: video.title,
  description: `Tonton video: ${video.title}. Sumber: ${video.source}`,
  ogDescription: `Tonton video: ${video.title}`,
  canonical: `/video/${video.slug}`,
  ogType: 'video.other',
  // When there's an embeddable player, use the Twitter "player" card so X can
  // inline-play; otherwise fall back to the large image card.
  twitterCard: embedUrl ? 'player' : 'summary_large_image',
  image: ogImage
    ? { url: ogImage, width: 1280, height: 720, alt: video.thumbnail_alt || video.title }
    : undefined,
}
const publishDate = formatDateID(video.published_at)

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: `Tonton video: ${video.title}`,
  thumbnailUrl: videoThumb,
  uploadDate: video.published_at,
  duration: toIsoDuration(video.duration),
  contentUrl: video.video_url || undefined,
  embedUrl: embedUrl || undefined,
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME || 'Beritana',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/images/logo-beritana.png` },
  },
}
---
<Layout seo={seo}>
  <Fragment slot="head">
    {/* Video-specific Open Graph + Twitter player (the shared Seo.astro only
        covers images). embedUrl present → advertise the player so social
        platforms can inline-play; thumbnail doubles as the poster. */}
    {embedUrl && (
      <>
        <meta property="og:video" content={embedUrl} />
        <meta property="og:video:secure_url" content={embedUrl} />
        <meta property="og:video:type" content="text/html" />
        <meta property="og:video:width" content="1280" />
        <meta property="og:video:height" content="720" />
        <meta name="twitter:player" content={embedUrl} />
        <meta name="twitter:player:width" content="1280" />
        <meta name="twitter:player:height" content="720" />
      </>
    )}
  </Fragment>

  <JsonLd schema={videoSchema} />
  <Breadcrumb items={[{ name: 'Video', href: '/video' }]} />

  <div class="container-main pb-12">
    <div class="mx-auto max-w-4xl">
      <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black">
        {embedUrl ? (
          <iframe
            src={embedUrl}
            title={video.title}
            class="h-full w-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        ) : (
          <div class="relative h-full w-full">
            <img src={videoThumb} alt={video.thumbnail_alt || video.title} width="1280" height="720" class="absolute inset-0 h-full w-full object-cover" />
            {video.video_url && (
              <a href={video.video_url} target="_blank" rel="noopener noreferrer" class="absolute inset-0 flex items-center justify-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 shadow-lg transition-transform hover:scale-110">
                  <svg class="h-8 w-8 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </div>
              </a>
            )}
          </div>
        )}
      </div>

      {video.thumbnail_credit && (
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">{video.thumbnail_credit}</p>
      )}

      <div class="mt-6">
        <h1 class="text-xl font-bold text-gray-900 dark:text-white sm:text-2xl lg:text-3xl">{video.title}</h1>

        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
          {video.source && (
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              {video.source}
            </span>
          )}
          {video.duration && (
            <span class="flex items-center gap-1">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {video.duration}
            </span>
          )}
          <time datetime={video.published_at}>{publishDate}</time>
          {video.category && (
            <a href={`/${video.category.slug}`} class="cat-badge rounded px-2 py-0.5 text-xs font-semibold text-white" style={`background-color: ${video.category.color || '#E53935'}`}>
              {video.category.name}
            </a>
          )}
        </div>

        <div class="mt-5">
          <ShareButtons url={`${siteUrl}/video/${video.slug}`} title={video.title} client:visible />
        </div>
      </div>

      {relatedVideos.length > 0 && (
        <div class="mt-10 border-t border-gray-200 pt-8 dark:border-gray-700">
          <h2 class="mb-6 flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-white">
            <span class="inline-block h-6 w-1 bg-primary" aria-hidden="true"></span>
            Video Lainnya
          </h2>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {relatedVideos.map((v) => (
              <a href={`/video/${v.slug}`} class="group">
                <div class="relative aspect-video overflow-hidden rounded-lg">
                  <img src={(v.thumbnail_url ? getImageUrl(v.thumbnail_url, { width: 400 }) : null) || ytPoster(v.video_url) || '/images/fallback-thumb.svg'} alt={v.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-white/80">
                      <svg class="h-5 w-5 text-gray-900" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    </div>
                  </div>
                  {v.duration && (
                    <span class="absolute bottom-2 right-2 rounded bg-black/70 px-1.5 py-0.5 text-[11px] font-medium text-white">{v.duration}</span>
                  )}
                </div>
                <h3 class="mt-2 line-clamp-2 text-sm font-bold text-gray-900 group-hover:text-primary dark:text-white">{v.title}</h3>
                <p class="mt-1 text-xs text-gray-500">{v.source}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
