---
/**
 * Foto detail — Astro equivalent of Next's src/app/foto/[slug]/page.tsx.
 * Emits ImageObject + Breadcrumb JSON-LD; ShareButtons hydrates.
 */
import Layout from '@/layouts/Layout.astro'
import JsonLd from '@/components/astro/JsonLd.astro'
import { apiFetchCached, getImageUrl } from '@/lib/api'
import { formatDateID } from '@/lib/date'
import { Breadcrumb } from '@/components/layout/Breadcrumb'
import { buildBreadcrumbSchema } from '@/lib/schema'
import { ShareButtons } from '@/components/article/ShareButtons'
import { SITE_URL_RAW, SITE_NAME } from '@/lib/env'
import type { SeoProps } from '@/lib/seo'

interface PhotoNews {
  id: number
  title: string
  slug: string
  thumbnail_url: string
  thumbnail_alt?: string
  thumbnail_credit?: string
  views?: number
  published_at: string
  category?: { id: number; name: string; slug: string; color?: string } | null
}

const { slug } = Astro.params
const siteUrl = (SITE_URL_RAW || 'https://beritana.com').replace(/\/$/, '')
const siteName = SITE_NAME || 'Beritana'

async function getPhoto(s: string): Promise<PhotoNews | null> {
  try {
    const res = await apiFetchCached<{ data: PhotoNews }>(`/photo-news/${s}`, 300)
    return res.data
  } catch {
    return null
  }
}
async function getRelatedPhotos(currentSlug: string): Promise<PhotoNews[]> {
  try {
    const res = await apiFetchCached<{ data: PhotoNews; related?: PhotoNews[] }>(`/photo-news/${currentSlug}`, 300)
    if (res.related && res.related.length > 0) return res.related
    const list = await apiFetchCached<{ data: PhotoNews[] }>('/photo-news', 300)
    return list.data.filter((p) => p.slug !== currentSlug).slice(0, 6)
  } catch {
    return []
  }
}

const [photo, relatedPhotos] = await Promise.all([getPhoto(slug!), getRelatedPhotos(slug!)])

if (!photo) {
  return Astro.rewrite('/404')
}

const ogImage = photo.thumbnail_url ? getImageUrl(photo.thumbnail_url, { width: 1200 }) : undefined
const seo: SeoProps = {
  title: photo.title,
  description: `Lihat foto: ${photo.title}`,
  canonical: `/foto/${photo.slug}`,
  ogType: 'article',
  image: ogImage
    ? { url: ogImage, width: 1200, height: 800, alt: photo.thumbnail_alt || photo.title }
    : undefined,
}

const publishDate = formatDateID(photo.published_at)
const photoImageUrl = getImageUrl(photo.thumbnail_url, { width: 1200 })
const imageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: photo.title,
  description: `Foto: ${photo.title}`,
  contentUrl: photoImageUrl,
  thumbnailUrl: photoImageUrl,
  uploadDate: photo.published_at,
  creditText: photo.thumbnail_credit || siteName,
  creator: { '@type': 'Organization', name: photo.thumbnail_credit || siteName },
  copyrightNotice: `© ${new Date(photo.published_at).getFullYear()} ${siteName}`,
  license: `${siteUrl}/pages/privacy-policy`,
  acquireLicensePage: `${siteUrl}/pages/contact`,
}
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Beranda', url: siteUrl },
  { name: 'Foto', url: `${siteUrl}/foto` },
  { name: photo.title, url: `${siteUrl}/foto/${photo.slug}` },
])
---
<Layout seo={seo}>
  <JsonLd schema={imageSchema} />
  <JsonLd schema={breadcrumbSchema} />
  <Breadcrumb items={[{ name: 'Foto', href: '/foto' }]} />

  <div class="container-main pb-12">
    <div class="mx-auto max-w-4xl">
      <figure class="relative overflow-hidden rounded-xl bg-gray-100 dark:bg-gray-800">
        <img src={getImageUrl(photo.thumbnail_url)} alt={photo.thumbnail_alt || photo.title} width="1200" height="800" class="w-full object-contain" />
        <figcaption class="px-4 py-2 text-xs text-gray-500 dark:text-gray-400">{photo.thumbnail_credit || photo.thumbnail_alt || photo.title}</figcaption>
      </figure>

      <div class="mt-6">
        <h1 class="text-xl font-bold text-gray-900 dark:text-white sm:text-2xl lg:text-3xl">{photo.title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
          <time datetime={photo.published_at}>{publishDate}</time>
          {photo.views && photo.views > 0 && (
            <span class="flex items-center gap-1">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              {photo.views >= 1000 ? `${(photo.views / 1000).toFixed(1)}k` : photo.views} views
            </span>
          )}
          {photo.category && (
            <a href={`/${photo.category.slug}`} class="cat-badge rounded px-2 py-0.5 text-xs font-semibold text-white" style={`background-color: ${photo.category.color || '#E53935'}`}>{photo.category.name}</a>
          )}
        </div>
        <div class="mt-5">
          <ShareButtons url={`${siteUrl}/foto/${photo.slug}`} title={photo.title} client:visible />
        </div>
      </div>

      {relatedPhotos.length > 0 && (
        <div class="mt-10 border-t border-gray-200 pt-8 dark:border-gray-700">
          <h2 class="mb-6 flex items-center gap-2 text-xl font-bold text-gray-900 dark:text-white">
            <span class="inline-block h-6 w-1 bg-primary" aria-hidden="true"></span>
            Foto Lainnya
          </h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
            {relatedPhotos.map((p) => (
              <a href={`/foto/${p.slug}`} class="group">
                <div class="relative aspect-[4/3] overflow-hidden rounded-lg">
                  <img src={getImageUrl(p.thumbnail_url)} alt={p.title} class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
                </div>
                <h3 class="mt-2 line-clamp-2 text-sm font-bold text-gray-900 group-hover:text-primary dark:text-white">{p.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
