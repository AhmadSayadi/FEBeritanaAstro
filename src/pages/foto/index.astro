---
/**
 * Foto Berita list — Astro equivalent of Next's src/app/foto/page.tsx.
 * Emits ImageGallery JSON-LD.
 */
import Layout from '@/layouts/Layout.astro'
import JsonLd from '@/components/astro/JsonLd.astro'
import { apiFetchCached, getImageUrl } from '@/lib/api'
import { formatDateID } from '@/lib/date'
import { Breadcrumb } from '@/components/layout/Breadcrumb'
import type { Article } from '@/lib/types'
import { SITE_URL_RAW, SITE_NAME } from '@/lib/env'
import type { SeoProps } from '@/lib/seo'

const siteUrl = (SITE_URL_RAW || 'https://beritana.com').replace(/\/$/, '')
const siteName = SITE_NAME || 'Beritana'

const seo: SeoProps = {
  title: 'Foto Berita',
  ogTitle: 'Foto Berita - Beritana',
  description: 'Kumpulan foto berita terbaru dari beritana.',
  canonical: '/foto',
  image: {
    url: '/foto/opengraph-image.png',
    width: 1200,
    height: 630,
    alt: 'Foto Berita Beritana',
  },
}

let photos: Article[] = []
try {
  const res = await apiFetchCached<{ data: Article[] }>('/photo-news?exclude_category=infografis', 60)
  photos = res.data
} catch {
  // empty
}

const imageGallerySchema =
  photos.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'ImageGallery',
        name: 'Foto Berita',
        url: `${siteUrl}/foto`,
        description: 'Kumpulan foto berita terbaru dari Beritana',
        publisher: { '@id': `${siteUrl}/#organization` },
        image: photos.slice(0, 20).map((photo) => ({
          '@type': 'ImageObject',
          name: photo.title,
          caption: photo.title,
          contentUrl: getImageUrl(photo.thumbnail_url, { width: 1200 }),
          url: `${siteUrl}/foto/${photo.slug}`,
          creditText: photo.thumbnail_credit || siteName,
          datePublished: photo.published_at,
        })),
      }
    : null
---
<Layout seo={seo}>
  {imageGallerySchema && <JsonLd schema={imageGallerySchema} />}
  <Breadcrumb items={[{ name: 'Foto Berita' }]} />

  <section class="container-main pb-12">
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">Foto Berita</h1>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Kumpulan foto berita terbaru</p>
    </div>

    {photos.length > 0 ? (
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {photos.map((photo) => (
          <a href={`/foto/${photo.slug}`} class="group overflow-hidden rounded-xl">
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={getImageUrl(photo.thumbnail_url)}
                alt={photo.thumbnail_alt || photo.title}
                title={photo.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              {photo.category && (
                <span class="cat-badge absolute left-3 top-3 rounded px-2 py-0.5 text-xs font-semibold text-white" style={`background-color: ${photo.category.color || '#E53935'}`}>
                  {photo.category.name}
                </span>
              )}
              {photo.views && photo.views > 0 && (
                <div class="absolute bottom-3 right-3 flex items-center gap-1 rounded-full bg-black/60 px-2 py-0.5">
                  <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  <span class="text-[11px] font-semibold text-white">{photo.views >= 1000 ? `${(photo.views / 1000).toFixed(1)}k` : photo.views}</span>
                </div>
              )}
            </div>
            <div class="mt-3">
              <h3 class="line-clamp-2 font-bold text-gray-900 group-hover:text-primary dark:text-white">{photo.title}</h3>
              <time datetime={photo.published_at} class="mt-1 block text-xs text-gray-500">{formatDateID(photo.published_at)}</time>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-500">Belum ada foto berita.</p>
    )}
  </section>
</Layout>
