# ─── Beritana (Astro) — environment variables ───────────────────────────────
# Copy this file to .env (production) or .env.local (local dev) and fill values.
#
# Variable names are kept identical to the old Next.js app so the migrated
# library code works unchanged. PUBLIC_* values are exposed to the browser
# (public IDs only); everything else is server-only (keep secrets here).

# Public site
PUBLIC_SITE_URL=https://beritana.com
PUBLIC_SITE_NAME=Beritana

# Backend (Laravel) API — SERVER ONLY (never expose the secret key)
API_BASE_URL=https://cms.beritana.com/api
PUBLIC_API_BASE_URL=https://cms.beritana.com/api
API_SECRET_KEY=replace-with-real-api-key

# Image CDN (Cloudflare R2)
PUBLIC_CDN_BASE_URL=https://cdn.beritana.com

# Legacy Cloudflare Image Resizing toggle. Leave false — the free quota is
# exhausted (error 9422). Image resizing is controlled by the provider below.
PUBLIC_CDN_RESIZE=false

# Image resize provider: off | cdn | wsrv.
#   off  = serve the original file untouched
#   cdn  = Cloudflare Image Resizing (/cdn-cgi/image/) — free quota 5k/mo
#   wsrv = images.weserv.nl, a FREE unlimited resize proxy (current choice)
PUBLIC_IMG_RESIZE_PROVIDER=wsrv

# On-demand revalidation webhook secret (SERVER ONLY)
REVALIDATE_SECRET=beritana-revalidate-2026

# IndexNow key — the matching file must exist at /public/{key}.txt
INDEXNOW_KEY=d2f69834934f47d6a4b275828157361f

# Analytics & AdSense (fallback if backend settings are empty)
PUBLIC_GA_ID=G-3VJCT8XY04
PUBLIC_ADSENSE_ID=ca-pub-2946511422357425

# Search engine verification (fallback if backend settings are empty)
PUBLIC_GOOGLE_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# Deploy target adapter: node (default) | vercel | cloudflare
# Only needed at build time. Node works on shared hosting/VPS and Vercel.
# DEPLOY_TARGET=node
